{
  "name": "oars-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "description": "OARS platform backend foundation",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "start": "node dist/index.js",
    "worker": "node dist/worker/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:docker": "tsx scripts/test-docker.ts",
    "perf:smoke": "tsx scripts/perf-smoke.ts",
    "conformance": "tsx scripts/conformance-suite.ts",
    "release:gate": "tsx scripts/release-gate.ts",
    "security:check": "tsx scripts/security-check.ts",
    "backup:create": "tsx scripts/backup-job.ts",
    "backup:restore": "tsx scripts/restore-job.ts",
    "backup:drill": "tsx scripts/dr-drill-job.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.1.4",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "cpu-features": false,
    "protobufjs": false,
    "ssh2": false
  }
}
