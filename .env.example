# OARS example environment configuration
#
# Copy to `.env` (not committed) and adjust for your deployment.

# Server bind
HOST=0.0.0.0
PORT=8080

# Environment
# Set to `production` in real deployments.
NODE_ENV=development

# Auth / secrets (REQUIRED in production)
# IMPORTANT: use strong, unique values from a secret manager.
OARS_JWT_SECRET=change_me
OARS_VAULT_KEY=change_me
OARS_APPROVAL_STEP_UP_SECRET=change_me

# Optional: enable dev tokens in production (NOT recommended)
# OARS_ALLOW_DEV_TOKENS_IN_PRODUCTION=false

# Optional: enable the built-in HTML dashboard route in production
# OARS_DASHBOARD_ENABLED=false

# Optional: bound OIDC discovery and JWKS refresh network requests
# OARS_JWKS_REQUEST_TIMEOUT_MS=5000
# OARS_JWKS_MAX_REFRESH_ATTEMPTS=2

# Optional: bound stored Idempotency-Key replay records (minimums: TTL 60s, interval 30s)
# OARS_IDEMPOTENCY_TTL_SECONDS=86400
# OARS_IDEMPOTENCY_PRUNE_INTERVAL_SECONDS=3600

# Optional storage backend
# OARS_STORE=file
# OARS_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/oars

# Optional: enable field-level encryption-at-rest (recommended when persisting sensitive payloads)
# OARS_DATA_ENCRYPTION_ENABLED=true
# OARS_DATA_ENCRYPTION_KEY=change_me

